# Production environment configuration.
#
# This file is committed on purpose: it holds only PUBLIC, non-secret values and it is
# the release source of truth for the site origin. Next.js loads it automatically for
# `next build` / `next start` (NODE_ENV=production); an explicit shell variable of the
# same name still takes precedence over what is set here.
#
# The canonical production origin. Every absolute URL the app emits (canonical tags,
# Open Graph / Twitter URLs, sitemap <loc>, the robots.txt sitemap pointer and all
# JSON-LD `url` / `item` values) derives from this single value.
NEXT_PUBLIC_SITE_URL=https://www.measuretobuild.in

# Optional: public contact address rendered on /about, /privacy and /terms.
# NEXT_PUBLIC_CONTACT_EMAIL=measuretobuild@gmail.com

# Google tag (Google Analytics 4) measurement ID. Public value, rendered on every page by
# src/components/analytics/GoogleTag.tsx. Set it here to change the tag without a code edit.
NEXT_PUBLIC_GA_ID=G-HK72FDCSWW

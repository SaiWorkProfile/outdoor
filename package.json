{
  "name": "outdoor-project-calculators",
  "version": "0.3.0",
  "private": true,
  "description": "Outdoor Project Calculator Platform — calculation engine and Next.js UI",
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:content": "tsx qa/content-check.ts",
    "verify": "npm run typecheck && npm test && npm run test:content",
    "qa:content": "node qa/content-a11y.cjs",
    "qa:calc-seo": "tsx qa/calculator-seo-check.ts",
    "qa:site-url": "node qa/site-url-guard.cjs",
    "qa:www-audit": "node qa/tmp/www-canonical-audit.cjs",
    "qa:analytics": "node qa/google-analytics-audit.cjs",
    "qa:prelaunch": "node qa/prelaunch.cjs"
  },
  "dependencies": {
    "next": "16.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "axe-core": "4.13.0",
    "lighthouse": "13.5.0",
    "puppeteer-core": "25.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}

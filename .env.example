# Example environment file. Copy to `.env.local` for local development.
#
# Production values live in the committed `.env.production` file; Next.js loads that
# one automatically for `next build` / `next start`.

# The canonical production origin — the single source of truth for every absolute URL
# (canonical, Open Graph / Twitter, sitemap, robots.txt, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.measuretobuild.in

# Optional: public contact address rendered on /about, /privacy and /terms.
NEXT_PUBLIC_CONTACT_EMAIL=measuretobuild@gmail.com
